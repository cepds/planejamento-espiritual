{
  "hosting": {
    "site": "meu-painel-espiritual",
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebase/**",
      ".git/**",
      ".github/**",
      "scripts/**",
      "package.json",
      "package-lock.json",
      "CODEX_INSTRUCOES.md"
    ],
    "headers": [
      {
        "source": "manifest.webmanifest",
        "headers": [
          { "key": "Content-Type", "value": "application/manifest+json" }
        ]
      },
      {
        "source": "sw.js",
        "headers": [
          { "key": "Service-Worker-Allowed", "value": "/" }
        ]
      },
      {
        "source": "**",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
        ]
      }
    ]
  }
}
